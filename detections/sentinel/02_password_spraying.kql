// Rule: Password spraying | MITRE T1110.003 | Python rule: password_spraying
// Logic: one source IP fails against >= 5 DIFFERENT usernames in 10 minutes.
let window = 10m;
let min_users = 5;
Syslog
| where ProcessName == "sshd" and (SyslogMessage has "Failed password" or SyslogMessage has "Invalid user")
| extend User = extract(@"(?:Failed password for (?:invalid user )?|Invalid user )(\S+)", 1, SyslogMessage),
         SrcIp = extract(@"from (\d{1,3}(?:\.\d{1,3}){3})", 1, SyslogMessage)
| summarize DistinctUsers = dcount(User), Users = make_set(User, 50),
            FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated)
    by SrcIp, Computer, bin(TimeGenerated, window)
| where DistinctUsers >= min_users

