// Rule: Invalid user probing (account enumeration) | MITRE T1087.001 | Python rule: invalid_user_probing
// Logic: >= 5 attempts with non-existent usernames from one IP in 10 minutes.
Syslog
| where ProcessName == "sshd" and SyslogMessage has "Invalid user"
| extend User = extract(@"Invalid user (\S+)", 1, SyslogMessage),
         SrcIp = extract(@"from (\d{1,3}(?:\.\d{1,3}){3})", 1, SyslogMessage)
| summarize Attempts = count(), UsernamesTried = make_set(User, 50) by SrcIp, Computer, bin(TimeGenerated, 10m)
| where Attempts >= 5

// Windows equivalent: 4625 with SubStatus 0xC0000064 = "user name does not exist"
// SecurityEvent | where EventID == 4625 and SubStatus =~ "0xc0000064"
//   | summarize Attempts = count() by IpAddress, bin(TimeGenerated, 10m) | where Attempts >= 5
