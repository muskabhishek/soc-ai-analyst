// Rule: Brute force | MITRE T1110.001 Password Guessing | Python rule: brute_force
// Logic: >= 10 failed logins from one source IP in 5 minutes.
// Note: bin() uses fixed 5-minute buckets; the Python engine uses a true sliding window.
let window = 5m;
let threshold = 10;
// --- Windows Security (Event ID 4625) ---
SecurityEvent
| where EventID == 4625
| summarize Failures = count(), Users = make_set(TargetUserName, 20),
            FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated)
    by IpAddress, Computer, bin(TimeGenerated, window)
| where Failures >= threshold
| order by Failures desc

